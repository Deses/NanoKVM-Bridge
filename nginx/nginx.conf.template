worker_processes  1;

error_log /dev/stdout info;
pid /run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    keepalive_timeout 65;

    server {
        listen 80;

        root /www;

        add_header X-Frame-Options "SAMEORIGIN";
        add_header X-Content-Type-Options "nosniff";

        index index.html;

        charset utf-8;

        # Filled in by entrypoint.sh: empty, or auth_basic when AUTH_* are set.
        include /etc/nginx/auth.conf;

        location / {
            try_files $uri $uri/ /index.html;
        }

        # Unbuffered, so frames go out as they arrive.
        location = /stream {
            proxy_pass http://127.0.0.1:8081/stream;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # WebSocket bridge to the serial/audio device.
        location /ws/ {
            proxy_pass http://127.0.0.1:8090/ws/;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # Status/config API served by the bridge.
        location /api/ {
            proxy_pass http://127.0.0.1:8090/api/;
            proxy_http_version 1.1;
            proxy_read_timeout 30s;
        }

        location = /robots.txt { access_log off; log_not_found off; }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
